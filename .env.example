# Secreto que Evolution manda en la cabecera apikey del webhook
SECRETO_WEBHOOK=cambia_esto
GEMINI_API_KEY=tu_clave
GEMINI_MODEL=gemini-3.1-flash-lite
# Datos (JSONL, medios, vigilados.json) y reportes (DATOS_DIR/reportes)
DATOS_DIR=./datos
PUERTO=3100
# Días que se guarda el texto de los chats que no vigilas (para recuperarlo al vigilarlos)
BUZON_DIAS=120
# Evolution API (docker compose up -d); la instancia se crea en el paso 3 del README
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=cambia_esto_tambien
EVOLUTION_INSTANCE=resumen
# Contraseña del Postgres de Evolution (solo letras y números: va dentro de una URI)
EVOLUTION_DB_PASSWORD=cambia_esto_tambien_2
# Hosts extra permitidos para el panel (por el tunel con Access), separados por coma
PANEL_HOSTS=
